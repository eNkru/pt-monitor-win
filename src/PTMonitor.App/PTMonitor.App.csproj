<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- The published exe is PTMonitor.exe, not PTMonitor.App.exe. Scoped here
         rather than passed as -p:AssemblyName on the command line, which would
         apply to every project in the graph and make two of them "PTMonitor". -->
    <AssemblyName>PTMonitor</AssemblyName>
    <!-- The exe icon shown in Explorer / taskbar / window title bars.
         Generated from the macOS app's AppIcon.icns by scripts/icns-to-ico.py
         so both platforms share one icon. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.2" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PTMonitor.Core\PTMonitor.Core.csproj" />
  </ItemGroup>
</Project>
