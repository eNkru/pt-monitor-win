<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PTMonitor.App.Views.ServerEditorWindow"
        Title="Edit Server"
        Width="440" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="16" Spacing="10">
        <TextBlock Text="Edit Server" FontWeight="SemiBold" FontSize="14" x:Name="HeaderLabel" />

        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,4,0,0"
              ColumnSpacing="10" RowSpacing="8">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Type" VerticalAlignment="Center" x:Name="TypeLabel" />
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="KindPicker" SelectionChanged="OnKindChanged" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" VerticalAlignment="Center" x:Name="NameLabel" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="NameField" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Host" VerticalAlignment="Center" x:Name="HostLabel" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="HostField" Watermark="nas.local or 192.168.1.2" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Port" VerticalAlignment="Center" x:Name="PortLabel" />
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="PortField" />

            <CheckBox Grid.Row="4" Grid.Column="1" x:Name="TlsToggle" Content="Use HTTPS" />
            <CheckBox Grid.Row="5" Grid.Column="1" x:Name="InsecureToggle" Content="Allow self-signed certificate" />
            <CheckBox Grid.Row="6" Grid.Column="1" x:Name="EnabledToggle" Content="Enabled" />

            <TextBlock Grid.Row="7" Grid.Column="0" Text="User name" VerticalAlignment="Center" x:Name="UserLabel" />
            <TextBox Grid.Row="7" Grid.Column="1" x:Name="UserField" />

            <TextBlock Grid.Row="8" Grid.Column="0" Text="Password" VerticalAlignment="Center" x:Name="PasswordLabel" />
            <TextBox Grid.Row="8" Grid.Column="1" x:Name="PasswordField" PasswordChar="•" />
        </Grid>

        <TextBlock x:Name="NoticeText" FontSize="11" Opacity="0.6" TextWrapping="Wrap" IsVisible="False" />
        <TextBlock x:Name="MessageText" FontSize="12" TextWrapping="Wrap" IsVisible="False" />

        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
            <Button x:Name="TestButton" Click="OnTest" />
            <Panel Width="8" />
            <Button x:Name="CancelButton" Click="OnCancel" />
            <Button x:Name="SaveButton" Classes="accent" Click="OnSave" />
        </StackPanel>
    </StackPanel>
</Window>
