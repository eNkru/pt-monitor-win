<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PTMonitor.App.ViewModels"
        xmlns:m="using:PTMonitor.Core.Model"
        x:Class="PTMonitor.App.Views.MainPanelWindow"
        x:DataType="vm:PanelViewModel"
        SystemDecorations="None"
        ShowInTaskbar="False"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="Manual">

    <Panel>
        <Border Classes="card" CornerRadius="14" Padding="14">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">

                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto" Grid.Row="0">
                    <StackPanel Grid.Column="0" Spacing="1">
                        <TextBlock Text="PT Monitor" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding HeaderFreshness}" FontSize="11" Opacity="0.6" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding HeaderServerCount}" FontSize="11"
                               Opacity="0.6" FontWeight="SemiBold" VerticalAlignment="Top" />
                </Grid>

                <Rectangle Grid.Row="1" Height="1" Opacity="0.1" Fill="White" Classes="hairline" Margin="0,10,0,0" />

                <!-- Aggregate grid -->
                <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0,10,0,0">
                    <StackPanel Grid.Column="0" Spacing="1">
                        <TextBlock Classes="statLabel" Text="↓ Speed" x:Name="DownLabel" />
                        <TextBlock Classes="statValue" Text="{Binding DownSpeedText}" />
                        <TextBlock Classes="statLabel" Text="↑ Speed" x:Name="UpLabel" />
                        <TextBlock Classes="statValue" Text="{Binding UpSpeedText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="1">
                        <TextBlock Classes="statLabel" Text="Active Torrents" x:Name="ActiveLabel" />
                        <TextBlock Classes="statValue" Text="{Binding ActiveTorrentsText}" />
                        <TextBlock Classes="statLabel" Text="Free Space" x:Name="FreeLabel" />
                        <TextBlock Classes="statValue" Text="{Binding FreeSpaceText}" />
                    </StackPanel>
                </Grid>

                <Rectangle Grid.Row="3" Height="1" Opacity="0.1" Fill="White" Classes="hairline" Margin="0,10,0,0" />

                <!-- Torrent list filter -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="4" Margin="0,10,0,0"
                            IsVisible="{Binding !IsEmptyState}">
                    <RadioButton x:Name="ModeAll" Classes="segment" Click="OnModeClicked" />
                    <RadioButton x:Name="ModeDown" Classes="segment" Click="OnModeClicked" />
                    <RadioButton x:Name="ModeUp" Classes="segment" Click="OnModeClicked" />
                    <RadioButton x:Name="ModeActive" Classes="segment" Click="OnModeClicked" />
                </StackPanel>

                <!-- Empty state -->
                <StackPanel Grid.Row="5" Spacing="10" IsVisible="{Binding IsEmptyState}" Margin="0,18,0,4">
                    <TextBlock Text="No servers configured" FontSize="12" FontWeight="SemiBold"
                               Opacity="0.6" HorizontalAlignment="Center" x:Name="EmptyText" />
                    <Button Content="Add Server…" Classes="accent" Click="OnAddServer"
                            HorizontalAlignment="Center" x:Name="AddServerButton" />
                </StackPanel>

                <!-- Server sections -->
                <ScrollViewer Grid.Row="6" MaxHeight="420" Margin="0,8,0,0" x:Name="SectionsScroll"
                              IsVisible="{Binding !IsEmptyState}">
                    <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ServerSectionViewModel">
                                <StackPanel Spacing="0">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Title}" Classes="sectionHeader" />
                                        <TextBlock Text="{Binding SpeedText}" Classes="sectionSpeed"
                                                   IsVisible="{Binding SpeedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <TextBlock Text="{Binding HoistedSite}" FontSize="10" Opacity="0.55"
                                                   IsVisible="{Binding HoistedSite, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>

                                    <!-- Failure -->
                                    <StackPanel Spacing="1" Margin="0,0,0,6"
                                                IsVisible="{Binding FailureHeadline, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="{Binding FailureHeadline}" FontSize="11" Foreground="#E5484D" />
                                        <TextBlock Text="{Binding FailureDetail}" FontSize="10" Opacity="0.55" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Note (connecting / no torrents / no matches) -->
                                    <TextBlock Text="{Binding NoteText}" FontSize="11" Opacity="0.55" Margin="0,0,0,6"
                                               IsVisible="{Binding NoteText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                                    <!-- Torrent rows -->
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TorrentRowViewModel">
                                                <StackPanel Spacing="4" Margin="0,0,0,7"
                                                            PointerPressed="OnRowPointerPressed">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                                        <Ellipse Grid.Column="0" Width="7" Height="7"
                                                                 Fill="{Binding StateBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                                                   FontWeight="Medium" TextWrapping="Wrap"
                                                                   MaxLines="2" TextTrimming="CharacterEllipsis" />
                                                        <Button Grid.Column="2" Classes="link" Click="OnOpenWebUi"
                                                                ToolTip.Tip="{Binding WebUiToolTip}"
                                                                CommandParameter="{Binding}"
                                                                Content="↗" FontSize="11" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <ProgressBar Grid.Column="0" Height="6" Minimum="0" Maximum="1"
                                                                     Value="{Binding Progress}" Classes="torrentBar" />
                                                        <TextBlock Grid.Column="1" Text="{Binding PercentText}" FontSize="10"
                                                                   Opacity="0.6" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="{Binding InfoText}" FontSize="10.5"
                                                                   Opacity="0.6" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding SiteText}" FontSize="10"
                                                                   Opacity="0.55"
                                                                   IsVisible="{Binding SiteText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                    </Grid>

                                                    <!-- Expanded detail -->
                                                    <ItemsControl ItemsSource="{Binding DetailCells}" Margin="10,2,0,6"
                                                                  IsVisible="{Binding IsExpanded}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <UniformGrid Columns="2" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:DetailCellViewModel">
                                                                <StackPanel Spacing="1" Margin="0,0,10,8">
                                                                    <TextBlock Text="{Binding Label}" Classes="statLabel" FontSize="9.5" />
                                                                    <TextBlock Text="{Binding Value}" Classes="statValue" FontSize="12" />
                                                                    <TextBlock Text="{Binding Note}" FontSize="10" Opacity="0.55"
                                                                               IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{Binding MoreText}" FontSize="10.5" Opacity="0.55"
                                               IsVisible="{Binding MoreText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Footer -->
                <StackPanel Grid.Row="7" Spacing="2" Margin="-6,10,-6,-6">
                    <Rectangle Height="1" Opacity="0.1" Fill="White" Margin="6,0,6,6" />
                    <Button Classes="footerRow" Click="OnRefreshNow" x:Name="RefreshButton">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="⟳" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                            <TextBlock Text="Refresh Now" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Classes="footerRow" Click="OnPreferences" x:Name="PreferencesButton">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="⚙" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                            <TextBlock Text="Preferences…" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Classes="footerRow" Click="OnQuit" x:Name="QuitButton">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="⏻" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                            <TextBlock Text="Quit PT Monitor" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Panel>
</Window>
