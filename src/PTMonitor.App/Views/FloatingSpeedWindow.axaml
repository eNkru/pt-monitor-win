<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:PTMonitor.App.Views"
        x:Class="PTMonitor.App.Views.FloatingSpeedWindow"
        SystemDecorations="None"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="#FF202023"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        WindowStartupLocation="Manual">

    <!-- A round badge, not a square window: the window itself paints nothing
         (`Background="Transparent"` + per-pixel alpha), so the four corners
         outside the circle are see-through instead of showing the window's
         square background. The body stays opaque — only the corners are
         transparent.
         `TransparencyBackgroundFallback` is the chip's own colour: on a
         platform that cannot do per-pixel alpha the chip degrades to the old
         opaque look instead of a white square behind the curve.
         The window is 64 × 64 while the circle is 60: the 2 px ring gives the
         Win32 window region (see Services/WindowShape) room to clip the
         corners without touching the antialiased circle edge. -->
    <Border x:Name="Chip" Classes="floatingChip"
            Width="60" Height="60" Margin="2"
            CornerRadius="30"
            ClipToBounds="True"
            PointerPressed="OnPointerPressed"
            PointerMoved="OnPointerMoved"
            PointerReleased="OnPointerReleased">
        <!-- The content is deliberately not hit-testable: the Border owns all
             pointer input, so its Hand cursor applies across the whole badge
             and every press reaches the drag/click handlers. `ClipToBounds`
             on the Border cuts the graph to the circle (Avalonia clips a
             Border's children to its rounded rect), so the plot reads as a
             circular gauge. -->
        <Grid IsHitTestVisible="False">
            <!-- Numbers mode: one block, centred in the circle. The rows are
                 not pinned to the outer thirds — a circle is narrowest at the
                 top and bottom, and the widest rate the chip can show
                 ("1023B") only fits near the middle. -->
            <Grid x:Name="NumbersView">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="4"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="DownArrow" Classes="floatingArrow" VerticalAlignment="Center" />
                        <TextBlock x:Name="DownText" Classes="floatingRate" VerticalAlignment="Center" />
                    </StackPanel>

                    <Rectangle Height="1" Width="26" Opacity="0.1" Fill="White"
                               HorizontalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" Spacing="4"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="UpArrow" Classes="floatingArrow" VerticalAlignment="Center" />
                        <TextBlock x:Name="UpText" Classes="floatingRate" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Graph mode: down green + up orange overlaid, newest at the
                 right. The plot is inset to the square inscribed in the circle
                 so the newest sample and the peak are never cut by the curve. -->
            <views:SpeedGraph x:Name="Graph" Margin="8" IsVisible="False" />

            <!-- Graph mode: the current rates pinned to the top centre. The
                 top-left corner of a circle is outside the shape, so the
                 readout is centred where the chord is wide enough for it; the
                 glyphs carry a dark outline, so the plot behind them stays
                 visible. -->
            <StackPanel x:Name="GraphRates" HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,10,0,0" Spacing="1" IsVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
                    <views:OutlinedText x:Name="GraphDownArrow" Classes="graphArrow" />
                    <views:OutlinedText x:Name="GraphDownText" Classes="graphRate" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
                    <views:OutlinedText x:Name="GraphUpArrow" Classes="graphArrow" />
                    <views:OutlinedText x:Name="GraphUpText" Classes="graphRate" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
