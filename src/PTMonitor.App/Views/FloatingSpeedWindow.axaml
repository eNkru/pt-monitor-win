<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:PTMonitor.App.Views"
        x:Class="PTMonitor.App.Views.FloatingSpeedWindow"
        SystemDecorations="None"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Background="#F0202023"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        WindowStartupLocation="Manual">

    <!-- Small opaque square: no transparency hint and no rounded corners, so
         the window composes no alpha layer. -->
    <!-- Background="Transparent" is a hit-test surface, not window
         transparency: without a non-null background the empty parts of the
         square do not receive pointer events, so only the digits would drag. -->
    <Border x:Name="Chip" Width="56" Height="56"
            Background="Transparent"
            BorderBrush="#26FFFFFF" BorderThickness="1"
            PointerPressed="OnPointerPressed"
            PointerMoved="OnPointerMoved"
            PointerReleased="OnPointerReleased">
        <!-- The content is deliberately not hit-testable: the Border owns all
             pointer input, so its Hand cursor applies across the whole square
             and every press reaches the drag/click handlers. -->
        <Grid IsHitTestVisible="False">
            <!-- Numbers mode -->
            <Grid x:Name="NumbersView" RowDefinitions="*,Auto,*">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="DownArrow" Classes="floatingArrow" VerticalAlignment="Center" />
                    <TextBlock x:Name="DownText" Classes="floatingRate" VerticalAlignment="Center" />
                </StackPanel>

                <Rectangle Grid.Row="1" Height="1" Width="28" Opacity="0.1" Fill="White" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="UpArrow" Classes="floatingArrow" VerticalAlignment="Center" />
                    <TextBlock x:Name="UpText" Classes="floatingRate" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Graph mode: down green + up orange overlaid, newest at the right -->
            <views:SpeedGraph x:Name="Graph" Margin="4" IsVisible="False" />
        </Grid>
    </Border>
</Window>
