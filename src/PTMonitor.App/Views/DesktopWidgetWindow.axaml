<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:PTMonitor.App.Views"
        x:Class="PTMonitor.App.Views.DesktopWidgetWindow"
        SystemDecorations="None"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        Background="#F0202023"
        Width="248" Height="152"
        CanResize="False"
        WindowStartupLocation="Manual">

    <!-- The card: an opaque window with a hairline border, the same look as
         the dropdown panel. Background="Transparent" is a hit-test surface,
         not window transparency: without it the empty parts of the card do
         not receive pointer events, so only the digits would drag. The
         rounded corners are cut out of the window itself (SetWindowRgn),
         because a layered window cannot be a child of the desktop host. -->
    <Border x:Name="Card" Classes="widgetCard" Background="Transparent" Padding="12"
            PointerPressed="OnPointerPressed"
            PointerMoved="OnPointerMoved"
            PointerReleased="OnPointerReleased">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

            <!-- Header: the product name and the lock control. -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="PT Monitor" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" x:Name="LockButton" Classes="link" FontSize="10"
                        VerticalAlignment="Center" Click="OnLockClicked" />
            </Grid>

            <!-- Aggregate rates. -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Margin="0,6,0,0">
                <TextBlock x:Name="DownArrow" Classes="statLabel" FontSize="13" VerticalAlignment="Center" />
                <TextBlock x:Name="DownText" Classes="statValue" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                <TextBlock x:Name="UpArrow" Classes="statLabel" FontSize="13" VerticalAlignment="Center" />
                <TextBlock x:Name="UpText" Classes="statValue" VerticalAlignment="Center" />
            </StackPanel>

            <!-- The rolling graph: one sample per second, 60 samples. -->
            <views:SpeedGraph Grid.Row="3" x:Name="Graph" Margin="0,6,0,0" />

            <!-- Summary: servers configured / online and active torrents. -->
            <TextBlock Grid.Row="4" x:Name="SummaryText" FontSize="9.5" Opacity="0.6"
                       Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
        </Grid>
    </Border>
</Window>
