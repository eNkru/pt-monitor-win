<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:PTMonitor.App.Views"
        x:Class="PTMonitor.App.Views.DesktopWidgetWindow"
        SystemDecorations="None"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        TransparencyLevelHint="Transparent"
        Background="#80000000"
        Width="250" Height="150"
        CanResize="False"
        WindowStartupLocation="Manual">

    <!-- A soft mask, not a card: no border, square corners, and the mask
         itself is translucent, so the wallpaper still shows through it (the
         window is per-pixel alpha, so the 50 % black mask is composited over
         the desktop). Every run carries a hard outline as well, so the text
         stays readable on a bright wallpaper too.
         Background="Transparent" on the Grid is a hit-test surface, not a
         fill: without a non-null brush the empty parts of the window do not
         receive pointer events, so only the glyphs would drag. -->
    <Grid x:Name="Card" Background="Transparent" Margin="8"
          RowDefinitions="Auto,Auto,Auto,*,Auto"
          PointerPressed="OnPointerPressed"
          PointerMoved="OnPointerMoved"
          PointerReleased="OnPointerReleased">

        <!-- Header: the product name and the lock control. It is invisible
             (row 0 keeps its height, so nothing moves) until the pointer is
             over the card; while hidden it does not hit-test, so a press in
             its corner still drags. -->
        <Grid Grid.Row="0" x:Name="Header" Classes="widgetHeader"
              Opacity="0" IsHitTestVisible="False" ColumnDefinitions="*,Auto">
            <views:OutlinedText Grid.Column="0" x:Name="TitleText" Classes="widgetTitle"
                                VerticalAlignment="Center" />
            <Button Grid.Column="1" x:Name="LockButton" Classes="widgetButton" Click="OnLockClicked"
                    VerticalAlignment="Center">
                <views:OutlinedText x:Name="LockText" Classes="widgetSummary" />
            </Button>
        </Grid>

        <!-- Aggregate rates. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="5" Margin="0,4,0,0">
            <views:OutlinedText x:Name="DownArrow" Classes="widgetArrow" VerticalAlignment="Center" />
            <views:OutlinedText x:Name="DownText" Classes="widgetRate" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="5" Margin="0,1,0,0">
            <views:OutlinedText x:Name="UpArrow" Classes="widgetArrow" VerticalAlignment="Center" />
            <views:OutlinedText x:Name="UpText" Classes="widgetRate" VerticalAlignment="Center" />
        </StackPanel>

        <!-- The rolling graph: one sample per second, 60 samples. -->
        <views:SpeedGraph Grid.Row="3" x:Name="Graph" Margin="0,4,0,0" />

        <!-- Status: one dot plus one number (not configured / N active /
             N/M online). The dot keeps its place in every form, so the line
             never re-flows; only its colour changes. -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="5"
                    Margin="0,4,0,0" VerticalAlignment="Bottom">
            <views:OutlinedText x:Name="StatusDot" Classes="widgetDot" Text="●"
                                VerticalAlignment="Center" />
            <views:OutlinedText x:Name="StatusText" Classes="widgetSummary"
                                VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
