<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:PTMonitor.App.Views"
             x:Class="PTMonitor.App.App"
             RequestedThemeVariant="Default">

    <Application.Styles>
        <FluentTheme />

        <!-- Dropdown panel card: dark surface in both themes, rounded, with a
             hairline border and a soft shadow (the CodexBar look). -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#F0202023" />
            <Setter Property="BorderBrush" Value="#26FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BoxShadow" Value="0 12 40 12 #66000000" />
        </Style>

        <!-- Desktop widget: the text is drawn straight on the desktop (no
             card, no plate, square corners), so every run carries a hard
             outline — the same technique as the graph labels — and stays
             readable on whatever wallpaper is behind it. -->
        <Style Selector="views|OutlinedText.widgetTitle">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Inter" />
            <Setter Property="Fill" Value="#F2F2F2" />
            <Setter Property="Outline" Value="#B3000000" />
            <Setter Property="OutlineThickness" Value="1.1" />
        </Style>

        <Style Selector="views|OutlinedText.widgetRate">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Fill" Value="#F2F2F2" />
            <Setter Property="Outline" Value="#B3000000" />
            <Setter Property="OutlineThickness" Value="1.2" />
        </Style>

        <Style Selector="views|OutlinedText.widgetArrow">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Fill" Value="#B3FFFFFF" />
            <Setter Property="Outline" Value="#B3000000" />
            <Setter Property="OutlineThickness" Value="1.4" />
        </Style>

        <Style Selector="views|OutlinedText.widgetSummary">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontFamily" Value="Inter" />
            <Setter Property="Fill" Value="#D9FFFFFF" />
            <Setter Property="Outline" Value="#8C000000" />
            <Setter Property="OutlineThickness" Value="1" />
        </Style>

        <!-- The status dot in front of the status line: a single glyph, so it
             is outlined like the text and readable on a bright wallpaper. The
             colour is a decision and is set from code-behind. -->
        <Style Selector="views|OutlinedText.widgetDot">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Fill" Value="#B3FFFFFF" />
            <Setter Property="Outline" Value="#8C000000" />
            <Setter Property="OutlineThickness" Value="1" />
        </Style>

        <!-- The header fades in while the pointer is over the card and out
             again after it leaves. A transition runs from the current value,
             so re-entering mid-fade reverses instead of snapping. -->
        <Style Selector="Grid.widgetHeader">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <!-- The widget's lock control: text on the desktop, so the button
             itself has no fill or border of its own. -->
        <Style Selector="Button.widgetButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Opacity" Value="0.75" />
        </Style>
        <Style Selector="Button.widgetButton:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.widgetButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Floating speed chip: small, opaque, no rounded corners, so the
             window needs no transparency/compositing layer. -->
        <Style Selector="TextBlock.floatingRate">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Consolas,Inter,monospace" />
        </Style>

        <Style Selector="TextBlock.floatingArrow">
            <Setter Property="FontSize" Value="8.5" />
            <Setter Property="Opacity" Value="0.5" />
        </Style>

        <!-- Graph-mode corner readout: outlined glyphs, so the numbers stay
             readable on top of the rolling graph without an opaque plate
             hiding the graph behind them. -->
        <Style Selector="views|OutlinedText.graphRate">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Fill" Value="#F2F2F2" />
            <Setter Property="Outline" Value="#E6000000" />
            <Setter Property="OutlineThickness" Value="1" />
        </Style>

        <Style Selector="views|OutlinedText.graphArrow">
            <Setter Property="FontSize" Value="8" />
            <Setter Property="Fill" Value="#A6FFFFFF" />
            <Setter Property="Outline" Value="#B3000000" />
            <Setter Property="OutlineThickness" Value="1" />
        </Style>

        <Style Selector="TextBlock.statLabel">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.55" />
        </Style>

        <Style Selector="TextBlock.statValue">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Consolas,Inter,monospace" />
        </Style>

        <Style Selector="TextBlock.sectionHeader">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.55" />
        </Style>

        <Style Selector="TextBlock.sectionSpeed">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="FontFamily" Value="Consolas,Inter,monospace" />
        </Style>

        <!-- Segmented mode picker -->
        <Style Selector="RadioButton.segment">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#22FFFFFF" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="RadioButton.segment:checked">
            <Setter Property="Background" Value="#2678787F" />
        </Style>

        <!-- Torrent progress bar -->
        <Style Selector="ProgressBar.torrentBar">
            <Setter Property="Foreground" Value="#5A8FD8" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>

        <!-- Trailing web-UI affordance -->
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.link:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- Footer action rows -->
        <Style Selector="Button.footerRow">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.footerRow:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#0F000000" />
        </Style>

        <Style Selector="Button.accent">
            <Setter Property="Padding" Value="14,6" />
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Foreground" Value="#E5484D" />
        </Style>

        <Style Selector="RadioButton.prefSegment">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Application.Styles>
</Application>
